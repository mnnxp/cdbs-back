# ===== Server =====
API_POINT=http://127.0.0.1:3000/graphql
DOMAIN=0.0.0.0
PORT=3000
RUST_LOG=info

# ===== Authentication =====
# JWT RSA key paths (generate with: openssl genrsa -out keys/rs256-4096-private.pem 4096)
JWT_PRIVATE_KEY=./keys/rs256-4096-private.pem
JWT_PUBLIC_KEY=./keys/rs256-4096-public.pem
AUTH_DURATION_IN_HOUR=24

# ===== CORS =====
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cdbs

# ===== S3 Storage =====
S3_APPLICATION_KEY_ID=your_key_id
S3_APPLICATION_KEY=your_secret_key
S3_ACCESS_EXPIRATION_AT=2030-01-01T00:00:00
S3_BUCKET=your_bucket
S3_REGION=your_region
S3_ENDPOINT=https://your-s3-endpoint
S3_EXP_PRESIGNED_URL=800

# ===== System UUIDs (must match database; change only when migrating existing data) =====
ROOT_COMPONENT_UUID=a5953fd9-7393-4f1e-a899-06b5e159dbf1
ROOT_STANDARD_UUID=303ec2aa-2066-42e3-93fb-de4fb9344bcb
ROOT_MODIFICATION_UUID=aba22d59-4f6c-44a4-9a37-2d38f0e577a8
DEFAULT_IMAGE_UUID=bc1c2151-86d0-4656-9c9d-d016dd584297
DEFAULT_USER_UUID=413a9b1c-da2d-44f9-a492-58f9448b402e